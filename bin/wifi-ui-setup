#!/bin/bash

if [ $(id -u) -ne 0 ]; then
	export SUDO_ASKPASS="/usr/bin/dmenu-askpass"
	exec sudo -A ${0}
fi

# --- Screen Logic ---
# Get the primary monitor's geometry (e.g., 1920x1080+0+0)
PRIMARY_GEO=$(xrandr | grep "primary" | awk '{print $4}')

# Extract Width, Height, and Offsets
SCREEN_W=$(echo $PRIMARY_GEO | cut -d'x' -f1)
SCREEN_H=$(echo $PRIMARY_GEO | cut -d'x' -f2 | cut -d'+' -f1)
OFFSET_X=$(echo $PRIMARY_GEO | cut -d'+' -f2)
OFFSET_Y=$(echo $PRIMARY_GEO | cut -d'+' -f3)

TINT2_PAD=35 

# Notification Dimensions
NOTIF_W=500
NOTIF_H=24

# Calculate Bottom-Right Position
# We subtract the notification height/width from the screen dimensions
POS_X=$((OFFSET_X + SCREEN_W - NOTIF_W))
POS_Y=$((OFFSET_Y + SCREEN_H - NOTIF_H - TINT2_PAD))

DZEN_OPTS="-p -w $NOTIF_W -h $NOTIF_H -x $POS_X -y $POS_Y -bg #222222"

INTERFACE=$(tail -n 1 /proc/net/wireless 2>/dev/null | awk -F ':' '{print $1}')

if [ -z "$INTERFACE" ]; then
	echo "No wireless interface detected" | dzen2 $DZEN_OPTS -p 5 -bg "#aa0000" -fn 'Source Code Pro for Powerline:style=Bold'
	exit 1
fi

TMP_CONFIG="/tmp/wpa_temp.conf"
PERM_CONFIG="/etc/wpa_supplicant.conf"

SSID=$(sudo /usr/sbin/iwlist "$INTERFACE" scan | grep 'ESSID' | cut -d'"' -f2 | grep -v '^$' | sort -u | dmenu -p "WiFi network ($INTERFACE):" -i -l 30)
[ -z "$SSID" ] && exit 1

PASS=$(echo "" | dmenu -p "Password for $SSID:")
#PASS=$(echo "" | dmenu -p "Password for $SSID:" -P)
/usr/sbin/wpa_passphrase "$SSID" "$PASS" > "$TMP_CONFIG"

# Attempt Connection
sudo /etc/rc.d/dhcpcd stop
sudo /etc/rc.d/wpa_supplicant stop
sudo pkill -f "wpa_supplicant.*$INTERFACE"
sleep 3
sudo /usr/sbin/wpa_supplicant -B -i "$INTERFACE" -c "$TMP_CONFIG"
sudo /etc/rc.d/dhcpcd start

# Verify
echo "Checking connection..." | dzen2 $DZEN_OPTS -fg "#55ff55" -fn 'Source Code Pro for Powerline:style=Bold' &
CHECK_PID=$!

SUCCESS=false
for i in {1..10}; do
	if ip addr show "$INTERFACE" | grep -q "inet " && ip addr show "$INTERFACE" | grep -q "state UP"; then
		SUCCESS=true
		break
	fi
	sleep 1
done

kill $CHECK_PID

if [ "$SUCCESS" = true ]; then
	SAVE_CHOICE=$(echo -e "No\nYes" | dmenu -p "Success! Save permanently?")
	if [ "$SAVE_CHOICE" == "Yes" ]; then
		if ! sudo grep -q -i "ssid[[:space:]]**=[[:space:]]*\"${SSID}\"" /etc/wpa_supplicant.conf; then
			/usr/sbin/wpa_passphrase "$SSID" "$PASS" | sudo tee -a "$PERM_CONFIG" > /dev/null
			echo "Network Saved" | dzen2 $DZEN_OPTS -p 5 -bg "#228b22" -fn 'Source Code Pro for Powerline:style=Bold' &
		else
			echo "Network already in /etc/wpa_supplicant.conf" | dzen2 $DZEN_OPTS -p 5 -bg "#228b22" -fn 'Source Code Pro for Powerline:style=Bold' &
		fi
	fi
else
	echo "Connection Failed" | dzen2 $DZEN_OPTS -p 5 -bg "#aa0000" -fn 'Source Code Pro for Powerline:style=Bold' &
	sudo pkill -f "wpa_supplicant.*$INTERFACE"
fi

rm "$TMP_CONFIG"
